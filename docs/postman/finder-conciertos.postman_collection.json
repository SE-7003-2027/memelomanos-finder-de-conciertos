              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Verifica que un usuario autenticado con rol USUARIO recibe 403 Forbidden con el formato ErrorRespuesta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Devuelve formato ErrorRespuesta\", function () {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.status).to.eql(403);",
                  "    pm.expect(cuerpo.error).to.eql(\"Forbidden\");",
                  "    pm.expect(cuerpo.mensaje).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
