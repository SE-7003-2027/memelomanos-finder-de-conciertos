      "name": "Administración",
      "item": [
        {
          "name": "Sincronizar conciertos sin rol ADMIN (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/sincronizar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "sincronizar"
              ]
            },
            "description": "Comprueba que /admin/sincronizar rechaza tokens sin rol ADMIN con 403 Forbidden."
          },
          "event": [
            {
              "listen": "test",
              "script": {
