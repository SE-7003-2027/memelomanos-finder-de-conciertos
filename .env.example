# Copia este archivo como .env y pon tus valores reales. El .env nunca se
# sube al repo (está en .gitignore). Spring no lee este archivo solo:
# exporta las variables en tu terminal o ponlas en la configuración de
# IntelliJ (ver README).

# Base de datos. Con el compose.yml del proyecto no hace falta definirlas.
DB_URL=jdbc:postgresql://localhost:5432/finder_conciertos
DB_USER=usuario
DB_PASSWORD=password

# Clave para firmar los tokens JWT. En producción usa una de al menos 32 caracteres.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Ticketmaster Discovery API (ADR-006). Si la API key queda vacía o
# TICKETMASTER_HABILITADO=false, el proveedor se desactiva sin lanzar errores.
TICKETMASTER_HABILITADO=true
TICKETMASTER_API_KEY=reemplaza_con_tu_ticketmaster_api_key
TICKETMASTER_SINCRONIZACION_CRON=0 0 */6 * * *

# Superboletos y Viagogo (ADR-006). Deshabilitados por defecto mientras no haya
# acceso a API (el sistema ofrece enlaces de búsqueda como Plan B).
SUPERBOLETOS_HABILITADO=false
SUPERBOLETOS_API_KEY=reemplaza_con_tu_superboletos_api_key
VIAGOGO_HABILITADO=false
VIAGOGO_API_KEY=reemplaza_con_tu_viagogo_api_key

# SoundCloud (ADR-005). Opcionales: si las dejas vacías, el reproductor
# usa oEmbed con la soundcloudUrl guardada en los conciertos (Plan B).
# Se obtienen al registrar una app en https://soundcloud.com/you/apps
# (requiere una cuenta con Artist Pro). Nunca las mandes al frontend.
SOUNDCLOUD_HABILITADO=true
SOUNDCLOUD_CLIENT_ID=reemplaza_con_tu_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=reemplaza_con_tu_soundcloud_client_secret
