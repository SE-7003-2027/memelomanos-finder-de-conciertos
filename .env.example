# Copia este archivo como .env y pon tus valores reales. El .env nunca se
# sube al repo (está en .gitignore). Spring no lee este archivo solo:
# exporta las variables en tu terminal o ponlas en la configuración de
# IntelliJ (ver README).

# Base de datos. Con el compose.yml del proyecto no hace falta definirlas.
DB_URL=jdbc:postgresql://localhost:5432/finder_conciertos
DB_USER=usuario
DB_PASSWORD=password

# Clave para firmar los tokens JWT. En producción usa una de al menos 32 caracteres.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# SoundCloud (ADR-005). Opcionales: si las dejas vacías, el reproductor
# usa oEmbed con la soundcloudUrl guardada en los conciertos (Plan B).
# Se obtienen al registrar una app en https://soundcloud.com/you/apps
# (requiere una cuenta con Artist Pro). Nunca las mandes al frontend.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
